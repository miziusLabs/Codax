{
  "name": "codax-launcher",
  "version": "4.0.7",
  "private": true,
  "description": "Desktop control center for Codax and its Codex integrations",
  "author": "miuuyy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm exec -- bun run scripts/dev.cjs",
    "audit": "npm audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "npm ci && npm run typecheck && npm run build:renderer",
    "build:runtime": "node scripts/prepare-runtime.cjs",
    "package": "npm run build && npm run build:runtime && node scripts/package.cjs",
    "package:mac": "npm run build && npm run build:runtime && node scripts/package.cjs --mac",
    "package:win": "npm run build && npm run build:runtime && node scripts/package.cjs --win",
    "package:linux": "npm run build && npm run build:runtime && node scripts/package.cjs --linux",
    "smoke:package": "node scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "bun": "1.4.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "dev.codax.launcher",
    "productName": "Codax",
    "artifactName": "codax-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "assets/linux-appimage-runner.sh",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "guid": "d1a6026a-6210-588e-9a2b-da3936f94e02",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "bun@1.4.0": true,
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
